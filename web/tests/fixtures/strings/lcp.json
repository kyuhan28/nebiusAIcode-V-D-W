{"files": {"longestcommonprefix.java": "import java.util.*;\n\npublic class longestcommonprefix {\n\n    public static String longestCommonPrefix(String[] strs) {\n        StringBuilder sb = new StringBuilder();\n        boolean f = false;\n\n        int i = 0;\n        while (i < strs[0].length()) {\n            for (int j = 1; j < strs.length; j++) {\n                if (i >= strs[j].length() || strs[0].charAt(i) != strs[j].charAt(i))\n                    f = true;\n            }\n            sb.append(strs[0].charAt(i));\n            i++;\n            if (f) break;\n        }\n        \n        return sb.toString();\n    }\n    \n    public static void main(String[] args) {\n        Scanner sc = new Scanner(System.in);\n        String[] strs = sc.nextLine().split(\"\\\\s+\");\n        System.out.println(longestCommonPrefix(strs));\n    }\n}\n"}, "result": {"mode": "trace", "javaVersion": "21.0.10+7-Ubuntu-124.04", "sandbox": "full", "entryPoints": [{"className": "longestcommonprefix", "path": "longestcommonprefix.java"}], "compileMs": 803, "diagnostics": [], "hierarchy": [{"name": "longestcommonprefix", "simpleName": "longestcommonprefix", "kind": "class", "abstract": false, "file": "longestcommonprefix.java", "line": 3, "superclass": "java.lang.Object", "interfaces": [], "methods": [{"name": "<init>", "descriptor": "()V", "params": [], "returns": "void", "modifiers": ["public"], "implicit": true, "line": 3, "overrides": null}, {"name": "longestCommonPrefix", "descriptor": "([Ljava/lang/String;)Ljava/lang/String;", "params": ["java.lang.String[] strs"], "returns": "java.lang.String", "modifiers": ["public", "static"], "implicit": false, "line": 5, "overrides": null}, {"name": "main", "descriptor": "([Ljava/lang/String;)V", "params": ["java.lang.String[] args"], "returns": "void", "modifiers": ["public", "static"], "implicit": false, "line": 23, "overrides": null}], "fields": []}], "entryPoint": "longestcommonprefix", "durationMs": 1394, "stdout": "flo\n", "stderr