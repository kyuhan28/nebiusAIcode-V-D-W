{"key": "c/recursion", "files": {"main.c": "#include <stdio.h>\nint fact(int n) {\n    if (n <= 1) {\n        return 1;\n    }\n    int r = n * fact(n - 1);\n    return r;\n}\n\nint main(void) {\n    int n = 5;\n    int r = fact(n);\n    printf(\"n=%d r=%d\\n\", n, r); // CHECK\n    return 0;\n}\n"}, "stdin": "", "run": {"mode": "run", "javaVersion": "21.0.10+7-Ubuntu-124.04", "sandbox": "full", "language": "c", "units": ["main.c"], "compileMs": 222, "compiler": "gcc (C17)", "diagnostics": [], "entryPoint": "main.c", "stdout": "n=5 r=120\n", "stderr": "", "stdoutTruncated": false, "stderrTruncated": false, "durationMs": 29, "memoryIssues": [], "exitCode": 0, "status": "completed"}, "result": {"mode": "trace", "javaVersion": "21.0.10+7-Ubuntu-124.04", "sandbox": "full", "language": "c", "units": ["main.c"], "compileMs": 130, "compiler": "gcc (C17)", "diagnostics": [], "entryPoint": "main.c", "durationMs": 138, "stdout": "n=5 r=120\n", "stderr": "", "stdoutTruncated": false, "stderrTruncated": false, "exitCode": 0, "trace": {"version": 2, "steps": [{"kind": "line", "line": 11, "sourcePath": "main.c", "cls": "", "method": "main", "out": 0, "stackDepth": 1, "stack": [{"id": 1, "depth": 0, "cls": "", "method": "main", "line": 11, "locals": {}, "args": [], "types": {}}], "statics": {}, "heap": {}, "memory": {"frames": [{"id": 1, "function": "main", "file": "main.c", "line": 11, "vars": [], "cfa": "0x7ffe0a0c32d0"}], "globals": [], "blocks": [], "events": [], "objects": [], "stats": {"live": 0, "liveBytes": 0, "freed": 0, "allocations": 0, "requestedBytes": 0, "peakBytes": 0}}}, {"kind": "line", "line": 12, "sourcePath": "main.c", "cls": "", "method": "main", "out": 0, "stackDepth": 1, "stack": [{"id": 1, "depth": 0, "cls": "", "method": "main", "line": 12, "locals": {"n": {"t": "int", "v": 5}}, "types": {"n": "int"}}], "statics": {}, "heap": {}, "memory": {"frames": [{"id": 1, "function": "main", "file": "main.c", "line": 12, "vars": [{"name": "n", "type": "int", "addr": 