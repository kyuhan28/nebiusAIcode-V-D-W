#!/usr/bin/env python3
"""A stand-in for the docker CLI, for testing the runner's container plumbing without Docker.

It records every invocation, maps /work and /opt/codeviz/classes back to host paths, and runs
the inner command locally. It provides NO isolation; it only proves the runner builds the right
docker commands, maps paths correctly, and removes containers on stop and timeout.
"""
import json, os, signal, sys
LOG = "/tmp/fakedocker/log.jsonl"
os.makedirs("/tmp/fakedocker/pids", exist_ok=True)
args = sys.argv[1:]
with open(LOG, "a") as f: f.write(json.dumps(args) + "\n")
cmd = args[0] if args else ""
if cmd == "version": print("27.3.1-fake"); sys.exit(0)
if cmd == "image": print("sha256:fake"); sys.exit(0)
if cmd == "ps": sys.exit(0)
if cmd == "rm":
    for name in args[2:]:
        try:
            pid = int(open(f"/tmp/fakedocker/pids/{name}").read())
            os.killpg(pid, signal.SIGKILL)
        except Exception: pass
    sys.exit(0)
if cmd == "run":
    with_value = {"--name", "--label", "--network", "--tmpfs", "--memory", "--memory-swap", "--cpus", "--pids-limit", "--cap-drop", "--security-opt", "--user", "--ulimit", "-v", "-w"}
    i, name, host = 1, None, None
    while i < len(args) and args[i].startswith("-"):
        if args[i] in with_value:
            if args[i] == "--name": name = args[i + 1]
            if args[i] == "-v": host = args[i + 1].split(":")[0]
            i += 2
        else: i += 1
    inner = args[i + 1:]
    classes = os.path.normpath(os.path.join(os.path.dirname(os.path.realpath(__file__)), "..", "..", "build", "classes"))
    # Emulate the container's view: /work is the job directory, /opt/codeviz/classes the runner's
    # classes. (Real Docker mounts these; this works only for one job at a time, which tests use.)
    if os.environ.get("FAKE_DOCKER_EMPTY_MOUNT") == "1":
        # Simulate a daemon on another machine: the bind mount arrives empty.
        host = "/tmp/fakedocker/empty"
        os.makedirs(host, exist_ok=True)
    if any("CompileMain" in a for a in inner) and os.path.isdir(os.path.join(host, "src")):
        modes = {os.path.relpath(os.path.join(d, n), host): oct(os.stat(os.path.join(d, n)).st_mode & 0o777)
                 for d, dirs, files in os.walk(os.path.join(host, "src")) for n in dirs + files}
        modes["src"] = oct(os.stat(os.path.join(host, "src")).st_mode & 0o777)
        with open(LOG, "a") as f: f.write(json.dumps(["modes", modes]) + "\n")
    for link, target in ((("/work", host),) if host else ()) + (("/opt/codeviz/classes", classes),):
        os.makedirs(os.path.dirname(link), exist_ok=True)
        tmp = link + ".tmp"
        if os.path.lexists(tmp): os.remove(tmp)
        os.symlink(target, tmp)
        os.replace(tmp, link)
    mapped = inner
    os.setpgid(0, 0)
    open(f"/tmp/fakedocker/pids/{name}", "w").write(str(os.getpid()))
    if host: os.chdir("/work")
    os.execvp(mapped[0], mapped)
sys.exit(f"fake docker: unsupported command {cmd}")
